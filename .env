# Qwen3-TTS Model Configuration
#
# Choose which model to run:
# - base          = Voice cloning from audio recordings (upload 3-10s audio)
# - customvoice   = 9 pre-defined speakers with emotion control
# - voicedesign   = Generate voices from text descriptions
# - small         = Smaller/faster customvoice model (0.6B)
#
# Default: base (for voice cloning)

MODEL=base
